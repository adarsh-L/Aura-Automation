# ──────────────────────────────────────────────────────────────────
# User Landing Page — Environment Variables
# Copy this file to .env and fill in your real values.
# ──────────────────────────────────────────────────────────────────

# Your n8n webhook endpoint (accepts POST with JSON: name, email, mobile, interest, budget)
VITE_WEBHOOK_URL=https://YOUR_N8N_INSTANCE.app.n8n.cloud/webhook/YOUR_WEBHOOK_ID

# Your Telegram bot deep-link (https://t.me/YOUR_BOT_USERNAME)
VITE_TELEGRAM_BOT_URL=https://t.me/YOUR_TELEGRAM_BOT
